# -------------------------------------------------------------
# Pineco Environment Configuration Example
# Copy this file to .env or set variables in your deployment host
# NEVER commit secrets or real credentials to Git!
# -------------------------------------------------------------

# Backend Settings (apps/api)
APP_ENV=development
API_PORT=8000
API_HOST=0.0.0.0
LOG_LEVEL=INFO

# Database Connection (PostgreSQL for Render/Production; sqlite:///./pineco.db for local fallback)
DATABASE_URL=sqlite:///./pineco.db
# Example for Render PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@hostname:5432/pineco

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server-Side AI Provider Settings (Never prefix with NEXT_PUBLIC_)
# Supported providers: openai, gemini, anthropic, groq, mock
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Max Upload Size (in MB)
MAX_UPLOAD_MB=10

# Frontend Settings (apps/web)
# Public API Base URL called by Next.js browser client
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEMO_MODE=true
